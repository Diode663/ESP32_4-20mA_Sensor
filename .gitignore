# KiCad local state, locks and history
*.kicad_prl
*.lck
~*
fp-info-cache
.history/
*-backups/

# generator backups and caches
.pcbgen-backup/
.schgen-backup/
__pycache__/

# vendor datasheets: copyrighted PDFs, fetch them from the manufacturers / LCSC
datasheets/*.pdf

# ESPHome: secrets are per-site, build trees are large and regenerable
firmware/secrets.yaml
.esphome/

# analyzer run folders are large and regenerable; the reviews themselves are in docs/
analysis/2026-*/
analysis/capability_mode.json

# routing and fab scratch: the autorouter's work folder (logs carry local paths),
# the intermediate CPL (the one to upload is in fab/), analyzer run state
routing/work/
jlc/
routing/capability_mode.json
routing/gerber_analysis.json
