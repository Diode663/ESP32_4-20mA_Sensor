# Copy to secrets.yaml (which is gitignored) and fill in.
#
#   api_encryption_key   32 random bytes, base64. Used for BOTH the API and
#                        encrypted OTA. Generate with:
#                          python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
#   ap_password          at least 8 characters, for the fallback hotspot

wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"
ap_password: "REPLACE_ME"
